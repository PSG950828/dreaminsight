{
  "name": "dreaminsight",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "ai": "./scripts/ai.sh",
    "di": "./scripts/di.js"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
  "lint": "pnpm run lint:eslint && pnpm run dict:validate",
  "lint:eslint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ai": "bash scripts/ai.sh",
    "di": "node scripts/di.js",
    "packs:generate": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/generate-packs.ts",
    "dict:import": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/import-dict.ts",
    "analyze": "TS_NODE_CACHE=false TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' npx ts-node src/lib/analyze.ts",
    "analyze:json": "TS_NODE_CACHE=false TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' npx ts-node src/lib/analyze.ts --json",
    "test:purple1": "npm run analyze:json -- \"보라불빛에서 ㅎㅎ 웃으며 달렸어\"",
    "test:purple2": "npm run analyze:json -- \"자주색 라이트가 번쩍, 러닝하면서 하하 웃었어\"",
    "smoke:analyze": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/smoke-analyze.ts",
    "smoke:community": "bash scripts/smoke-community.sh",
    "suggest:lex": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/suggest-lex.ts",
    "eval:regression": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/eval-regression.ts",
    "eval:report": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/eval-report.ts",
    "check:aliases": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/check-alias-collisions.ts",
    "gen:cases": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/gen-cases.ts",
    "alias:suggest": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/alias-gen-pr.ts",
    "backup:restore-sql": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/restore-db-from-json.ts",
    "backup:storage-sync": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/storage-sync-from-manifest.ts",
    "ops:health": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/ops-health.ts",
    "ops:webhook:replay": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/ops-webhook-replay.ts",
    "ops:entitlement:update": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/ops-entitlement-update.ts",
    "ops:rl-csrf": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/ops-rl-csrf-check.ts"
    ,
    "ops:coverage:ingest": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/ops-coverage-ingest.ts",
    "dict:validate": "TS_NODE_CACHE=false TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' ts-node scripts/validate-dict.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.541.0",
    "next": "15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.11",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.2"
  }
}
